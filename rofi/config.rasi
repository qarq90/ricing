entry {
    placeholder: "Search...";
    text-color : rgba(244, 244, 244, 1);
    padding: 8px 0px 8px 8px;
    background-color: transparent;
    border: none; 
    cursor: none;
}

configuration {
    font: "Noto Sans 12";
    lines: 10;
    fixed-num-lines: true;
    padding: 10px;
}

inputbar {
    children: [entry];
}

* {
    separatorcolor: transparent;
    selected-normal-background: rgba(255,255,255, 10%);
    normal-background: rgba(255,255,255, 0%);
    alternate-normal-background: rgba(255,255,255, 0%);
}

mainbox {
    border: 1px;
    border-color: rgba(255,255,255, 20%);
    background-color: rgba(28, 28, 28, 0.90);
    padding: 12px 16px;
}

window {
    border: 1px solid;
    border-color: #000000;
    background-color: rgba(28, 28, 28, 0.90);
    padding: 0px;
    width: 40%;
}

listview {
    lines: 10;
}

element {
    padding: 10px 16px;
    height: 40px;
    children: [ element-text ];
    spacing: 16px;
}

element selected {
    background-color: rgba(255,255,255, 10%);
}

element-text {
    text-color : rgba(244, 244, 244, 1);
}

#scrollbar {
    handle-color: rgba(244, 244, 244, 0.5);
    handle-width: 4px ;
    padding: 0;
}

#prompt {
    text-color: rgba(244, 244, 244, 0.7);
}